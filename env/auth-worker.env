export TLS_CERTIFICATE_PATH="$LOCAL/certs/auth-worker/cert.pem"
export TLS_PRIVATE_KEY_PATH="$LOCAL/certs/auth-worker/key.pem"
export TEMPORAL_TLS_CERTIFICATE_PATH="$LOCAL/certs/auth-worker/cert.pem"
export TEMPORAL_TLS_PRIVATE_KEY_PATH="$LOCAL/certs/auth-worker/key.pem"
export POSTGRES_PORT=5432
export POSTGRES_SERVICE_PASSWORD_PATH="$LOCAL/secrets/auth/postgres-service-password"
export GRPC_USERS_HOST=localhost
export TEMPORAL_WORKER_BUILDID=local
export TEMPORAL_WORKER_CLIENT_IDENTITY=auth-worker
