# Shared by every local process. $LOCAL is harbor-dev/.local, set by up.sh.
export TLS_TRUST_ROOTS_PATH="$LOCAL/certs/ca.pem"
export JWT_PUBLIC_KEY_PATH="$LOCAL/jwt/public.pem"
export POSTGRES_HOST=localhost
export POSTGRES_TLS_TRUST_ROOTS_PATH="$LOCAL/certs/ca.pem"
export TEMPORAL_HOST=localhost
export TEMPORAL_TLS_TRUST_ROOTS_PATH="$LOCAL/certs/ca.pem"
export TEMPORAL_CLIENT_INSTRUMENTATION_SERVERHOSTNAME=localhost
export TEMPORAL_WORKER_CLIENT_INSTRUMENTATION_SERVERHOSTNAME=localhost
# No collector runs locally.
export OTEL_SDK_DISABLED=true
export LOG_LEVEL=info
